{
  "name": "git-backup",
  "version": "0.1.0",
  "description": "Mirror local git repos to a backup remote and snapshot uncommitted work into generational buckets",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "bun build --compile --minify --outfile git-backup src/cli.ts",
    "dev": "bun run src/cli.ts",
    "check": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "commander": "^15.0.0"
  }
}
